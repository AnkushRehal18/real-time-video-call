# Server Port
PORT=5000

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=https://real-time-video-call-nine.vercel.app

# Node Environment: development | production
NODE_ENV=production

# Minimum log level: error | warn | info | http | debug
# Defaults to "info" in production, "debug" in development
LOG_LEVEL=info

# Neon PostgreSQL connection string
# Replace with your actual Neon database URL. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
